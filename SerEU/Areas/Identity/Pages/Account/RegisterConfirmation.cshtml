@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirme o seu email";
}

<div class="auth-wrapper">
    <div class="confirm-card text-center shadow-lg">
        <div class="confirm-icon">
            <i class="bi bi-envelope-paper-heart"></i>
        </div>

        <h1 class="h3 fw-bold mb-2">Confirme o seu email</h1>
        <p class="text-muted mb-1">Enviámos uma mensagem de confirmação para:</p>
        <p class="fw-semibold fs-5 mb-4">@Model.Email</p>

        <div class="confirm-steps text-start mb-4">
            <div class="d-flex align-items-start gap-3 mb-3">
                <span class="confirm-step-num">1</span>
                <span>Abra a caixa de entrada do seu email.</span>
            </div>
            <div class="d-flex align-items-start gap-3 mb-3">
                <span class="confirm-step-num">2</span>
                <span>Clique no link de confirmação que lhe enviámos.</span>
            </div>
            <div class="d-flex align-items-start gap-3">
                <span class="confirm-step-num">3</span>
                <span>Volte e inicie sessão na sua conta.</span>
            </div>
        </div>

        <p class="text-muted small mb-4">
            <i class="bi bi-info-circle me-1"></i>
            Não recebeu nada? Verifique a pasta de <strong>Spam</strong> ou lixo eletrónico.
        </p>

        <a asp-page="./Login" class="btn btn-outline-secondary w-100">
            <i class="bi bi-box-arrow-in-right me-1"></i>Ir para o início de sessão
        </a>
    </div>
</div>