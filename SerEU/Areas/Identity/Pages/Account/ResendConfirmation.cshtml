@page
@model ResendConfirmationModel
@{
    ViewData["Title"] = "Reenviar email de confirmação";
    Layout = "_Layout";
}

<div class="container my-5" style="max-width: 500px;">
    <div class="auth-card shadow-lg">
        <div class="auth-form">
            <h1 class="h3 fw-bold mb-4">Reenviar email de confirmação</h1>
            
            @if (Model.Success)
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle me-2"></i>
                    Novo email de confirmação enviado para @Model.Email!
                </div>
            }
            else
            {
                <p class="text-muted mb-4">
                    Introduza o seu email para receber um novo link de confirmação.
                </p>
                
                <form method="post">
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="nome@exemplo.com"/>
                        <label asp-for="Input.Email"><i class="bi bi-envelope me-1"></i>Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100 btn-lg">
                        <i class="bi bi-envelope-paper me-1"></i>Reenviar email
                    </button>
                </form>
            }
            
            <div class="mt-3 text-center">
                <a asp-page="./Login" class="text-decoration-none">Voltar ao login</a>
            </div>
        </div>
    </div>
</div>
