@page
@model LoginModel
@{
    ViewData["Title"] = "Entrar";
}

<div class="auth-wrapper">
    <div class="auth-card shadow-lg">
        <!-- Painel de marca -->
        <div class="auth-brand">
            <div>
                <i class="bi bi-globe-europe-africa auth-brand-icon"></i>
                <h2 class="fw-bold mb-2">Serviços Digitais Europeus</h2>
                <p class="mb-0 opacity-75">
                    Aceda à sua conta para submeter serviços, deixar avaliações e contribuir
                    para uma Europa digital aberta e respeitadora da privacidade.
                </p>
            </div>
            <ul class="auth-brand-list">
                <li><i class="bi bi-shield-check me-2"></i>Privacidade em primeiro lugar</li>
                <li><i class="bi bi-people me-2"></i>Comunidade colaborativa</li>
                <li><i class="bi bi-star me-2"></i>Avaliações da comunidade</li>
            </ul>
        </div>

        <!-- Painel do formulário -->
        <div class="auth-form">
            <h1 class="h3 fw-bold mb-1">Bem-vindo de volta</h1>
            <p class="text-muted mb-4">Introduza as suas credenciais para continuar.</p>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 d-none-empty" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username"
                           aria-required="true" placeholder="nome@exemplo.com"/>
                    <label asp-for="Input.Email"><i class="bi bi-envelope me-1"></i>Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password"
                           aria-required="true" placeholder="Palavra-passe"/>
                    <label asp-for="Input.Password"><i class="bi bi-lock me-1"></i>Palavra-passe</label>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Input.RememberMe"/>
                        <label class="form-check-label" asp-for="Input.RememberMe"></label>
                    </div>
                    <a asp-page="./ForgotPassword" class="small text-decoration-none">Esqueceu-se da palavra-passe?</a>
                </div>

                <button id="login-submit" type="submit" class="btn btn-primary w-100 btn-lg mb-3">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Entrar
                </button>

                <p class="text-center text-muted mb-0">
                    Ainda não tem conta?
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold text-decoration-none">Registe-se</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}