@page "{id:int}"
@model SerEU.Pages.Servicos.EditModel
@{
    ViewData["Title"] = "Editar Serviço";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Index">Início</a></li>
                <li class="breadcrumb-item"><a asp-page="Index">Serviços</a></li>
                <li class="breadcrumb-item active">Editar</li>
            </ol>
        </nav>

        <h1 class="mb-4"><i class="bi bi-pencil me-2 text-warning"></i>Editar Serviço</h1>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form method="post">
                    <input type="hidden" asp-for="Servico.Id"/>
                    <input type="hidden" asp-for="Servico.UtilizadorId"/>
                    <input type="hidden" asp-for="Servico.DataSubmissao"/>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Servico.Nome" class="form-label fw-bold"></label>
                            <input asp-for="Servico.Nome" class="form-control"/>
                            <span asp-validation-for="Servico.Nome" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Servico.CategoriaId" class="form-label fw-bold"></label>
                            <select asp-for="Servico.CategoriaId" asp-items="Model.CategoriasSelectList" class="form-select"></select>
                            <span asp-validation-for="Servico.CategoriaId" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Servico.Descricao" class="form-label fw-bold"></label>
                            <textarea asp-for="Servico.Descricao" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Servico.Descricao" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Servico.Url" class="form-label fw-bold"></label>
                            <input asp-for="Servico.Url" class="form-control"/>
                            <span asp-validation-for="Servico.Url" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Servico.LogotipoUrl" class="form-label fw-bold"></label>
                            <input asp-for="Servico.LogotipoUrl" class="form-control"/>
                            <span asp-validation-for="Servico.LogotipoUrl" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Servico.Pais" class="form-label fw-bold"></label>
                            <input asp-for="Servico.Pais" class="form-control"/>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Servico.Licenca" class="form-label fw-bold"></label>
                            <input asp-for="Servico.Licenca" class="form-control"/>
                        </div>
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="Servico.Aprovado" class="form-check-input" type="checkbox"/>
                                    <label asp-for="Servico.Aprovado" class="form-check-label fw-bold"></label>
                                </div>
                            </div>
                        }
                        <div class="col-12">
                            <label class="form-label fw-bold">Tags</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var tag in Model.Tags)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="TagsSelecionadas"
                                               value="@tag.Id" id="tag_@tag.Id"
                                               checked="@(Model.TagsDoServico.Contains(tag.Id))"/>
                                        <label class="form-check-label" for="tag_@tag.Id">@tag.Nome</label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save me-1"></i>Guardar Alterações
                        </button>
                        <a asp-page="Details" asp-route-id="@Model.Servico.Id" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
