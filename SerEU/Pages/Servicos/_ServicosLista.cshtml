@using System.Security.Claims
@model IEnumerable<SerEU.Models.ServicoDigital>
@{
    var utilizadorAtualId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}
@foreach (var servico in Model)
{
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0 card-servico">
            <div class="card-body">
                <div class="d-flex align-items-start gap-3 mb-2">
                    @if (!string.IsNullOrEmpty(servico.LogotipoUrl))
                    {
                        <img src="@servico.LogotipoUrl" alt="@servico.Nome" class="rounded"
                             style="width:48px;height:48px;object-fit:contain" onerror="this.style.display='none'"/>
                    }
                    else
                    {
                        <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:48px;height:48px;font-size:1.5rem">
                            <i class="bi @(servico.Categoria.Icone ?? "bi-app")"></i>
                        </div>
                    }
                    <div class="min-w-0">
                        <h5 class="card-title mb-1 text-truncate">@servico.Nome</h5>
                        <div class="d-flex flex-wrap gap-1">
                            <span class="badge bg-secondary">@servico.Categoria.Nome</span>
                            @if (!string.IsNullOrEmpty(servico.Pais))
                            {
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-geo-alt me-1"></i>@servico.Pais
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <p class="card-text text-muted small">
                    @(servico.Descricao.Length > 120 ? servico.Descricao[..120] + "…" : servico.Descricao)
                </p>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var tag in servico.Tags.Take(4))
                    {
                        <span class="badge bg-light text-dark border small">@tag.Nome</span>
                    }
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center">
                <small class="text-muted">
                    <i class="bi bi-star-fill text-warning me-1"></i>
                    @(servico.MediaAvaliacoes > 0 ? servico.MediaAvaliacoes.ToString("F1") : "—")
                    (@servico.TotalAvaliacoes avaliações)
                </small>
                <div class="d-flex gap-1">
                    <a asp-page="Details" asp-route-id="@servico.Id" class="btn btn-primary btn-sm">Ver</a>
                    @if (User.IsInRole("Admin") || (servico.UtilizadorId == utilizadorAtualId && !servico.Aprovado))
                    {
                        <a asp-page="Edit" asp-route-id="@servico.Id" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-pencil"></i>
                        </a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-page="Delete" asp-route-id="@servico.Id" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-trash"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
}