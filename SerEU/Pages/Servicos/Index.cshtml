@page
@model SerEU.Pages.Servicos.IndexModel
@{
    ViewData["Title"] = "Serviços Digitais";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-search me-2 text-primary"></i>Serviços Digitais</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Submeter Serviço</a>
    }
</div>

<!-- Filtros -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get">
            <div class="row g-2">
                <div class="col-md-4">
                    <input type="text" name="pesquisa" value="@Model.Pesquisa" class="form-control"
                           placeholder="Pesquisar por nome ou descrição..."/>
                </div>
                <div class="col-md-3">
                    <select name="categoriaId" class="form-select">
                        <option value="">Todas as categorias</option>
                        @foreach (var cat in Model.Categorias)
                        {
                            <option value="@cat.Id" selected="@(Model.CategoriaId == cat.Id)">@cat.Nome</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="tagId" class="form-select">
                        <option value="">Todas as tags</option>
                        @foreach (var tag in Model.Tags)
                        {
                            <option value="@tag.Id" selected="@(Model.TagId == tag.Id)">@tag.Nome</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-search"></i> Filtrar
                    </button>
                    <a asp-page="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-12">
                    <div class="d-flex justify-content-end">
                        <select name="ordenarPor" class="form-select form-select-sm" style="width: 250px;" onchange="this.form.submit()">
                            <option value="">Ordenar por...</option>
                            <optgroup label="Data de Submissão">
                                <option value="recentes" selected="@(Model.OrdenarPor == "recentes")">Mais recentes primeiro</option>
                                <option value="antigos" selected="@(Model.OrdenarPor == "antigos")">Mais antigos primeiro</option>
                            </optgroup>
                            <optgroup label="Nome">
                                <option value="nome-az" selected="@(Model.OrdenarPor == "nome-az")">Nome (A-Z)</option>
                                <option value="nome-za" selected="@(Model.OrdenarPor == "nome-za")">Nome (Z-A)</option>
                            </optgroup>
                            <optgroup label="Avaliação">
                                <option value="melhor-avaliado" selected="@(Model.OrdenarPor == "melhor-avaliado")">Melhor avaliação</option>
                                <option value="pior-avaliado" selected="@(Model.OrdenarPor == "pior-avaliado")">Pior avaliação</option>
                                <option value="mais-avaliacoes" selected="@(Model.OrdenarPor == "mais-avaliacoes")">Mais avaliações</option>
                                <option value="menos-avaliacoes" selected="@(Model.OrdenarPor == "menos-avaliacoes")">Menos avaliações</option>
                            </optgroup>
                            <optgroup label="País">
                                <option value="pais-az" selected="@(Model.OrdenarPor == "pais-az")">País (A-Z)</option>
                                <option value="pais-za" selected="@(Model.OrdenarPor == "pais-za")">País (Z-A)</option>
                            </optgroup>
                        </select>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Resultados -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted">@Model.TotalServicos resultado(s) encontrado(s)</span>
</div>

@if (Model.TotalServicos == 0)
{
    <div class="alert alert-info text-center py-5">
        <i class="bi bi-search fs-1 d-block mb-2"></i>
        Nenhum serviço encontrado com os filtros aplicados.
        <br/>
        <a asp-page="Index" class="btn btn-outline-primary mt-2">Ver todos os serviços</a>
    </div>
}
else
{
    <div id="grid-servicos" class="row g-3"
         data-pagina="1"
         data-tem-mais="@Model.TemMais.ToString().ToLowerInvariant()">
        <partial name="_ServicosLista" model="Model.Servicos"/>
    </div>

    <div id="sentinela-servicos" class="text-center py-4">
        <div id="spinner-servicos" class="spinner-border text-primary d-none" role="status">
            <span class="visually-hidden">A carregar mais serviços...</span>
        </div>
        <div id="fim-servicos" class="text-muted d-none">
            <i class="bi bi-check2-circle me-1"></i>Chegou ao fim da lista.
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            const grid = document.getElementById('grid-servicos');
            if (!grid) return;

            const sentinela = document.getElementById('sentinela-servicos');
            const spinner = document.getElementById('spinner-servicos');
            const fim = document.getElementById('fim-servicos');

            let pagina = parseInt(grid.dataset.pagina, 10) || 1;
            let temMais = grid.dataset.temMais === 'true';
            let aCarregar = false;

            function mostrarFim() {
                fim.classList.remove('d-none');
            }

            // Anima a entrada de um conjunto de cartões, com um ligeiro efeito em cascata.
            function animarCartoes(elementos) {
                elementos.forEach((el, i) => {
                    el.style.animationDelay = Math.min(i * 60, 400) + 'ms';
                    el.classList.add('servico-aparece');
                });
            }

            // Anima os cartões já presentes na primeira página.
            animarCartoes(Array.from(grid.children));

            if (!temMais) {
                mostrarFim();
                return;
            }

            async function carregarMais() {
                if (aCarregar || !temMais) return;
                aCarregar = true;
                spinner.classList.remove('d-none');

                const params = new URLSearchParams(window.location.search);
                params.set('handler', 'Cartoes');
                params.set('pagina', pagina + 1);

                try {
                    const resp = await fetch(`${window.location.pathname}?${params.toString()}`, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    if (!resp.ok) throw new Error('Falha ao carregar serviços');

                    const html = (await resp.text()).trim();
                    if (html.length > 0) {
                        const antes = grid.children.length;
                        grid.insertAdjacentHTML('beforeend', html);
                        animarCartoes(Array.from(grid.children).slice(antes));
                        pagina += 1;
                    }
                    temMais = resp.headers.get('X-Tem-Mais') === 'true' && html.length > 0;
                } catch (e) {
                    console.error(e);
                    // permite nova tentativa ao voltar a rolar
                } finally {
                    aCarregar = false;
                    spinner.classList.add('d-none');
                    if (!temMais) {
                        mostrarFim();
                        observer.disconnect();
                    }
                }
            }

            const observer = new IntersectionObserver((entries) => {
                if (entries[0].isIntersecting) carregarMais();
            }, { rootMargin: '300px' });

            observer.observe(sentinela);
        })();
    </script>
}
