@page "{id:int}"
@model SerEU.Pages.Servicos.DetailsModel
@{
    ViewData["Title"] = Model.Servico?.Nome ?? "Detalhe do Serviço";
}

@if (Model.Servico == null)
{
    <div class="alert alert-danger">Serviço não encontrado.</div>
    return;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Início</a></li>
        <li class="breadcrumb-item"><a asp-page="Index">Serviços</a></li>
        <li class="breadcrumb-item active">@Model.Servico.Nome</li>
    </ol>
</nav>

<div class="row g-4">
    <!-- Coluna principal -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <div class="d-flex align-items-start gap-3 mb-3">
                    @if (!string.IsNullOrEmpty(Model.Servico.LogotipoUrl))
                    {
                        <img src="@Model.Servico.LogotipoUrl" alt="@Model.Servico.Nome"
                             class="rounded" style="width:64px;height:64px;object-fit:contain"
                             onerror="this.style.display='none'"/>
                    }
                    else
                    {
                        <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:64px;height:64px;font-size:2rem">
                            <i class="bi @(Model.Servico.Categoria.Icone ?? "bi-app")"></i>
                        </div>
                    }
                    <div>
                        <h1 class="h2 mb-1">@Model.Servico.Nome</h1>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge bg-secondary">@Model.Servico.Categoria.Nome</span>
                            @if (!Model.Servico.Aprovado)
                            {
                                <span class="badge bg-warning text-dark">Pendente de aprovação</span>
                            }
                        </div>
                    </div>
                </div>

                <p class="lead text-muted">@Model.Servico.Descricao</p>

                <div class="d-flex flex-wrap gap-1 mb-3">
                    @foreach (var tag in Model.Servico.Tags)
                    {
                        <a asp-page="Index" asp-route-tagId="@tag.Id"
                           class="badge bg-light text-dark border text-decoration-none">
                            <i class="bi bi-tag me-1"></i>@tag.Nome
                        </a>
                    }
                </div>

                @if (User.IsInRole("Admin") || Model.Servico.UtilizadorId == Model.UtilizadorAtualId)
                {
                    <div class="d-flex gap-2">
                        <a asp-page="Edit" asp-route-id="@Model.Servico.Id" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-pencil me-1"></i>Editar
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-page="Delete" asp-route-id="@Model.Servico.Id" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash me-1"></i>Eliminar
                            </a>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Avaliações -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <h4 class="mb-0"><i class="bi bi-star-fill text-warning me-2"></i>Avaliações (@Model.Servico.TotalAvaliacoes)</h4>
            </div>
            <div class="card-body">
                @if (User.Identity?.IsAuthenticated == true && !Model.JaAvaliou)
                {
                    <div class="card bg-light border-0 mb-4">
                        <div class="card-body">
                            <h5>Deixar uma avaliação</h5>
                            <form method="post" asp-page-handler="Avaliar">
                                <input type="hidden" asp-for="NovaAvaliacao.ServicoDigitalId" value="@Model.Servico.Id"/>
                                <div class="mb-3">
                                    <label asp-for="NovaAvaliacao.Nota" class="form-label fw-bold">Nota (1-5)</label>
                                    <select asp-for="NovaAvaliacao.Nota" class="form-select" style="max-width:120px">
                                        <option value="5">⭐⭐⭐⭐⭐ (5)</option>
                                        <option value="4">⭐⭐⭐⭐ (4)</option>
                                        <option value="3">⭐⭐⭐ (3)</option>
                                        <option value="2">⭐⭐ (2)</option>
                                        <option value="1">⭐ (1)</option>
                                    </select>
                                    <span asp-validation-for="NovaAvaliacao.Nota" class="text-danger small"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="NovaAvaliacao.Comentario" class="form-label fw-bold">Comentário (opcional)</label>
                                    <textarea asp-for="NovaAvaliacao.Comentario" class="form-control" rows="3"
                                              placeholder="Partilhe a sua experiência com este serviço..."></textarea>
                                    <span asp-validation-for="NovaAvaliacao.Comentario" class="text-danger small"></span>
                                </div>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-send me-1"></i>Submeter Avaliação
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else if (Model.JaAvaliou)
                {
                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i> Já avaliou este serviço.
                    </div>
                }
                else if (!User.Identity?.IsAuthenticated ?? true)
                {
                    <div class="alert alert-secondary small mb-4">
                        <a asp-area="Identity" asp-page="/Account/Login">Inicie sessão</a> para deixar uma avaliação.
                    </div>
                }

                @if (!Model.Servico.Avaliacoes.Any())
                {
                    <p class="text-muted text-center py-3">Ainda não há avaliações. Seja o primeiro!</p>
                }
                else
                {
                    @foreach (var av in Model.Servico.Avaliacoes.OrderByDescending(a => a.Data))
                    {
                        <div class="d-flex gap-3 mb-3 pb-3 border-bottom">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width:40px;height:40px">
                                <i class="bi bi-person"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <span class="fw-bold small">@(av.Utilizador?.Email ?? "Utilizador")</span>
                                        <span class="text-warning ms-2">@string.Concat(Enumerable.Repeat("⭐", av.Nota))</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <small class="text-muted">@av.Data.ToString("dd/MM/yyyy")</small>
                                        @if (User.IsInRole("Admin") || av.UtilizadorId == Model.UtilizadorAtualId)
                                        {
                                            <form method="post" asp-page-handler="EliminarAvaliacao" class="d-inline">
                                                <input type="hidden" name="avaliacaoId" value="@av.Id"/>
                                                <button type="submit" class="btn btn-link btn-sm text-danger p-0"
                                                        onclick="return confirm('Eliminar esta avaliação?')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(av.Comentario))
                                {
                                    <p class="mb-0 text-muted small mt-1">@av.Comentario</p>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <h5 class="card-title mb-3">Informação</h5>
                <ul class="list-unstyled">
                    <li class="mb-2">
                        <i class="bi bi-link-45deg text-primary me-2"></i>
                        <a href="@Model.Servico.Url" target="_blank" rel="noopener" class="text-truncate d-inline-block" style="max-width:200px">
                            Visitar Website
                        </a>
                    </li>
                    @if (!string.IsNullOrEmpty(Model.Servico.Pais))
                    {
                        <li class="mb-2">
                            <i class="bi bi-geo-alt text-primary me-2"></i>
                            <span>@Model.Servico.Pais</span>
                        </li>
                    }
                    @if (!string.IsNullOrEmpty(Model.Servico.Licenca))
                    {
                        <li class="mb-2">
                            <i class="bi bi-file-earmark-text text-primary me-2"></i>
                            <span>@Model.Servico.Licenca</span>
                        </li>
                    }
                    <li class="mb-2">
                        <i class="bi bi-calendar text-primary me-2"></i>
                        <span>@Model.Servico.DataSubmissao.ToString("dd/MM/yyyy")</span>
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-grid text-primary me-2"></i>
                        <a asp-page="Index" asp-route-categoriaId="@Model.Servico.CategoriaId">
                            @Model.Servico.Categoria.Nome
                        </a>
                    </li>
                </ul>
                @if (Model.Servico.MediaAvaliacoes > 0)
                {
                    <div class="text-center mt-2">
                        <div class="display-6 fw-bold text-warning">@Model.Servico.MediaAvaliacoes.ToString("F1")</div>
                        <div class="text-muted small">média de @Model.Servico.TotalAvaliacoes avaliação(ões)</div>
                    </div>
                }
            </div>
        </div>

        <!-- Serviços relacionados -->
        @if (Model.ServicosRelacionados.Any())
        {
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h6 class="mb-0">Serviços Relacionados</h6>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var rel in Model.ServicosRelacionados)
                    {
                        <a asp-page="Details" asp-route-id="@rel.Id"
                           class="list-group-item list-group-item-action d-flex align-items-center gap-2">
                            <i class="bi @(rel.Categoria.Icone ?? "bi-app") text-primary"></i>
                            <span class="small">@rel.Nome</span>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
