@page
@model SerEU.Pages.Erros._404Model
@{
    ViewData["Title"] = "Página Não Encontrada";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="text-center py-5">
    <div class="display-1 text-muted fw-bold">404</div>
    <h2 class="mb-3">Página Não Encontrada</h2>
    <p class="text-muted mb-4">O recurso que procura não existe ou foi removido.</p>
    <div class="d-flex gap-2 justify-content-center">
        <a asp-page="/Index" class="btn btn-primary">
            <i class="bi bi-house me-1"></i>Ir para o Início
        </a>
        <a asp-page="/Servicos/Index" class="btn btn-outline-primary">
            <i class="bi bi-search me-1"></i>Pesquisar Serviços
        </a>
    </div>
</div>
