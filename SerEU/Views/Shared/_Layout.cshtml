@using Microsoft.EntityFrameworkCore
@using SerEU.Data
@inject ApplicationDbContext Db
@{
    // Para administradores, calcula o número de serviços pendentes de aprovação.
    // Este valor inicializa o "badge" da campainha; depois é atualizado em
    // tempo real via SignalR.
    var aprovacoesPendentes = 0;
    var ehAdmin = User.IsInRole("Admin");
    if (ehAdmin)
    {
        aprovacoesPendentes = await Db.ServicosDigitais.CountAsync(s => !s.Aprovado);
    }

    // Notificações pessoais do utilizador autenticado (aprovação/rejeição de serviços).
    var minhasNotificacoes = new List<SerEU.Models.Notificacao>();
    var notificacoesNaoLidas = 0;
    if (User.Identity?.IsAuthenticated == true)
    {
        var meuId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        minhasNotificacoes = await Db.Notificacoes
            .Where(n => n.UtilizadorId == meuId)
            .OrderByDescending(n => n.Data)
            .Take(20)
            .ToListAsync();
        notificacoesNaoLidas = minhasNotificacoes.Count(n => !n.Lida);
    }
}
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>SerEu | @ViewData["Title"] </title>
    <script>
        // Aplica o tema (claro/escuro) o mais cedo possível para evitar "flash" visual.
        (function () {
            try {
                var guardado = localStorage.getItem('tema');
                var preferido = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                document.documentElement.setAttribute('data-bs-theme', guardado || preferido);
            } catch (e) {
                document.documentElement.setAttribute('data-bs-theme', 'light');
            }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/SerEU.styles.css" asp-append-version="true"/>
</head>
<body>
<partial name="_EmailConfirmationBanner" />
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand" asp-page="/Index">
                <img src="/assets/logo-sereu.svg" alt="SerEU" height="64" class="d-inline-block align-text-top me-2">
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                    aria-controls="navbarMain" aria-expanded="false" aria-label="Alternar navegação">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Servicos/Index">
                            <i class="bi bi-search me-1"></i>Serviços
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Categorias/Index">
                            <i class="bi bi-grid me-1"></i>Categorias
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Tags/Index">
                            <i class="bi bi-tags me-1"></i>Tags
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Sobre">
                            <i class="bi bi-info-circle me-1"></i>Sobre
                        </a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-gear me-1"></i>Administração
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/Admin/Index">Painel</a></li>
                                <li><a class="dropdown-item" asp-page="/Admin/Aprovacoes">Aprovações Pendentes</a></li>
                                <li><hr class="dropdown-divider"/></li>
                                <li><a class="dropdown-item" asp-page="/Categorias/Create">Nova Categoria</a></li>
                                <li><a class="dropdown-item" asp-page="/Tags/Create">Nova Tag</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-outline-light btn-sm" asp-page="/Servicos/Create">
                            <i class="bi bi-plus-circle me-1"></i>Submeter Serviço
                        </a>
                    }
                    <!-- Alternar tema claro/escuro -->
                    <button class="btn btn-outline-light btn-sm" type="button" id="btnTema"
                            title="Alternar tema claro/escuro" aria-label="Alternar tema">
                        <i class="bi bi-moon-stars-fill" id="iconeTema"></i>
                    </button>
                    @if (ehAdmin)
                    {
                        <!-- Campainha de aprovações pendentes (só administradores) -->
                        <a class="btn btn-outline-light btn-sm position-relative" asp-page="/Admin/Aprovacoes"
                           id="btnAprovacoesPendentes" title="Aprovações pendentes" aria-label="Aprovações pendentes">
                            <i class="bi bi-bell-fill"></i>
                            <span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle @(aprovacoesPendentes == 0 ? "d-none" : "")"
                                  id="badge-pendentes">@aprovacoesPendentes</span>
                        </a>
                    }
                    <!-- Notificações SignalR (broadcast: novo serviço aprovado) -->
                    <div id="notificacao-container" class="position-relative" style="display:none">
                        <button class="btn btn-outline-light btn-sm" type="button" id="btnNotificacoes">
                            <i class="bi bi-megaphone"></i>
                            <span class="badge bg-danger" id="badge-count">0</span>
                        </button>
                    </div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- Notificações pessoais do utilizador -->
                        <div class="dropdown">
                            <button class="btn btn-outline-light btn-sm position-relative" type="button"
                                    id="btnNotificacoesPessoais" data-bs-toggle="dropdown" data-bs-auto-close="outside"
                                    aria-expanded="false" title="Notificações" aria-label="Notificações">
                                <i class="bi bi-bell-fill"></i>
                                <span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle @(notificacoesNaoLidas == 0 ? "d-none" : "")"
                                      id="badge-notificacoes-pessoais">@notificacoesNaoLidas</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow" id="lista-notificacoes"
                                style="min-width:330px; max-height:420px; overflow-y:auto"
                                aria-labelledby="btnNotificacoesPessoais">
                                <li><h6 class="dropdown-header"><i class="bi bi-bell me-1"></i>Notificações</h6></li>
                                @if (!minhasNotificacoes.Any())
                                {
                                    <li><span class="dropdown-item-text text-muted small" id="notif-vazio">Não tem notificações.</span></li>
                                }
                                else
                                {
                                    foreach (var n in minhasNotificacoes)
                                    {
                                        <li>
                                            <div class="dropdown-item-text small @(n.Lida ? "" : "fw-semibold")" style="white-space:normal">
                                                <i class="bi @(n.Tipo == "sucesso" ? "bi-check-circle text-success" : n.Tipo == "erro" ? "bi-x-circle text-danger" : "bi-info-circle text-primary") me-1"></i>
                                                @n.Mensagem
                                                <div class="text-muted" style="font-size:0.7rem">@n.Data.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                            </div>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    }
                    <partial name="_LoginPartial"/>
                </div>
            </div>
        </div>
    </nav>
</header>

<!-- Toast de notificações SignalR -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
    <div id="toastNotificacao" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toast-mensagem">
                <i class="bi bi-check-circle me-1"></i> Novo serviço aprovado!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
    <!-- Toast de notificação pessoal (serviço do utilizador aprovado/rejeitado) -->
    <div id="toastPessoal" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toast-pessoal-mensagem"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
    @if (ehAdmin)
    {
        <!-- Toast para novas submissões pendentes (só administradores) -->
        <div id="toastPendente" class="toast align-items-center text-dark bg-warning border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="toast-pendente-mensagem">
                    <i class="bi bi-bell-fill me-1"></i> Nova submissão a aguardar aprovação!
                </div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    }
</div>

<div class="container mt-3 layout-content">
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Aviso"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-1"></i> @TempData["Aviso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <main role="main" class="pb-4">
        @RenderBody()
    </main>
</div>

<footer class="border-top bg-light mt-4 py-3">
    <div class="container text-center text-muted small">
        <span>&copy; 2025-2026 Serviços Digitais Europeus &mdash;</span>
        <a asp-page="/Sobre" class="text-muted ms-1">Sobre o Projeto</a>
        <span class="mx-1">|</span>
        <a asp-controller="Home" asp-action="Privacy" class="text-muted">Privacidade</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    // Ligação ao hub SignalR para notificações em tempo real
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/hubs/notificacoes")
        .withAutomaticReconnect()
        .build();

    let contadorNotificacoes = 0;

    connection.on("NovoServicoAprovado", function (nomeServico) {
        contadorNotificacoes++;
        const badge = document.getElementById("badge-count");
        const container = document.getElementById("notificacao-container");
        const mensagem = document.getElementById("toast-mensagem");

        if (badge) badge.textContent = contadorNotificacoes;
        if (container) container.style.display = "block";
        if (mensagem) mensagem.innerHTML = `<i class="bi bi-check-circle me-1"></i> Novo serviço aprovado: <strong>${nomeServico}</strong>`;

        const toastEl = document.getElementById("toastNotificacao");
        if (toastEl) {
            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }
    });

    // Atualiza o "badge" de aprovações pendentes (só existe para administradores).
    function atualizarBadgePendentes(total) {
        const badge = document.getElementById("badge-pendentes");
        if (!badge) return;
        badge.textContent = total;
        badge.classList.toggle("d-none", !total || total <= 0);
    }

    // Nova submissão a aguardar aprovação: atualiza contador e mostra um toast.
    connection.on("AprovacaoPendente", function (nomeServico, totalPendentes) {
        atualizarBadgePendentes(totalPendentes);

        const mensagem = document.getElementById("toast-pendente-mensagem");
        if (mensagem) mensagem.innerHTML = `<i class="bi bi-bell-fill me-1"></i> Nova submissão a aguardar aprovação: <strong>${nomeServico}</strong>`;

        const toastEl = document.getElementById("toastPendente");
        if (toastEl) {
            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }
    });

    // Uma aprovação foi resolvida (aprovada ou rejeitada): apenas atualiza o contador.
    connection.on("AprovacoesAtualizadas", function (totalPendentes) {
        atualizarBadgePendentes(totalPendentes);
    });

    // ===== Notificações pessoais (o serviço do utilizador foi aprovado/rejeitado) =====
    (function () {
        const btn = document.getElementById("btnNotificacoesPessoais");
        const badge = document.getElementById("badge-notificacoes-pessoais");
        const lista = document.getElementById("lista-notificacoes");

        function iconePorTipo(tipo) {
            if (tipo === "sucesso") return '<i class="bi bi-check-circle text-success me-1"></i>';
            if (tipo === "erro") return '<i class="bi bi-x-circle text-danger me-1"></i>';
            return '<i class="bi bi-info-circle text-primary me-1"></i>';
        }

        function atualizarBadgePessoal(naoLidas) {
            if (!badge) return;
            badge.textContent = naoLidas;
            badge.classList.toggle("d-none", !naoLidas || naoLidas <= 0);
        }

        // Ao abrir o menu, marca as notificações como lidas.
        if (btn) {
            btn.addEventListener("click", function () {
                if (badge && !badge.classList.contains("d-none")) {
                    fetch("/api/notificacoes/marcar-lidas", {
                        method: "POST",
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    }).then(() => atualizarBadgePessoal(0)).catch(err => console.error(err));
                }
            });
        }

        connection.on("NotificacaoPessoal", function (mensagem, tipo, naoLidas) {
            atualizarBadgePessoal(naoLidas);

            // Insere a nova notificação no topo da lista do dropdown.
            if (lista) {
                const vazio = document.getElementById("notif-vazio");
                if (vazio) vazio.closest("li").remove();

                const li = document.createElement("li");
                li.innerHTML = `<div class="dropdown-item-text small fw-semibold" style="white-space:normal">`
                    + `${iconePorTipo(tipo)}${mensagem}`
                    + `<div class="text-muted" style="font-size:0.7rem">agora mesmo</div></div>`;

                const header = lista.querySelector(".dropdown-header");
                if (header) header.closest("li").after(li); else lista.prepend(li);
            }

            // Mostra um toast.
            const toastEl = document.getElementById("toastPessoal");
            const corpo = document.getElementById("toast-pessoal-mensagem");
            if (toastEl && corpo) {
                toastEl.classList.remove("bg-success", "bg-danger");
                toastEl.classList.add(tipo === "erro" ? "bg-danger" : "bg-success");
                corpo.innerHTML = `${iconePorTipo(tipo)}${mensagem}`;
                new bootstrap.Toast(toastEl).show();
            }
        });
    })();

    connection.start().catch(err => console.error("Erro SignalR:", err.toString()));
</script>
<script>
    // Alternância de tema claro/escuro com persistência em localStorage
    (function () {
        const btn = document.getElementById('btnTema');
        const icone = document.getElementById('iconeTema');

        function aplicarIcone(tema) {
            if (!icone) return;
            icone.className = tema === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
        }

        aplicarIcone(document.documentElement.getAttribute('data-bs-theme'));

        if (btn) {
            btn.addEventListener('click', function () {
                const atual = document.documentElement.getAttribute('data-bs-theme');
                const novo = atual === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-bs-theme', novo);
                try { localStorage.setItem('tema', novo); } catch (e) { /* ignora */ }
                aplicarIcone(novo);
            });
        }
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
