@page
@model RegisterModel
@{
    ViewData["Title"] = "Registar";
}

<div class="auth-wrapper">
    <div class="auth-card shadow-lg">
        <!-- Painel de marca -->
        <div class="auth-brand">
            <div>
                <i class="bi bi-person-plus auth-brand-icon"></i>
                <h2 class="fw-bold mb-2">Junte-se à comunidade</h2>
                <p class="mb-0 opacity-75">
                    Crie a sua conta gratuita e ajude a mapear os melhores serviços digitais
                    europeus, abertos e respeitadores da privacidade.
                </p>
            </div>
            <ul class="auth-brand-list">
                <li><i class="bi bi-plus-circle me-2"></i>Submeta novos serviços</li>
                <li><i class="bi bi-chat-square-text me-2"></i>Avalie e comente</li>
                <li><i class="bi bi-shield-lock me-2"></i>Os seus dados protegidos</li>
            </ul>
        </div>

        <!-- Painel do formulário -->
        <div class="auth-form">
            <h1 class="h3 fw-bold mb-1">Criar conta</h1>
            <p class="text-muted mb-4">É rápido e gratuito.</p>

            <form id="registerForm" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 d-none-empty" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username"
                           aria-required="true" placeholder="nome@exemplo.com"/>
                    <label asp-for="Input.Email"><i class="bi bi-envelope me-1"></i>Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password"
                           aria-required="true" placeholder="Palavra-passe"/>
                    <label asp-for="Input.Password"><i class="bi bi-lock me-1"></i>Palavra-passe</label>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-2">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password"
                           aria-required="true" placeholder="Confirmar palavra-passe"/>
                    <label asp-for="Input.ConfirmPassword"><i class="bi bi-lock-fill me-1"></i>Confirmar palavra-passe</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <p class="text-muted small mb-4">
                    <i class="bi bi-info-circle me-1"></i>
                    Mínimo de 8 caracteres, com maiúsculas, minúsculas, um dígito e um símbolo.
                </p>

                <button id="registerSubmit" type="submit" class="btn btn-primary w-100 btn-lg mb-3">
                    <i class="bi bi-person-check me-1"></i>Criar conta
                </button>

                <p class="text-center text-muted mb-0">
                    Já tem conta?
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold text-decoration-none">Entrar</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}