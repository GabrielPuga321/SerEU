@page "{id:int}"
@model EuropeanListofDigitalServices.Pages.Tags.DeleteModel
@{
    ViewData["Title"] = "Eliminar Tag";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <h1 class="mb-4"><i class="bi bi-trash text-danger me-2"></i>Eliminar Tag</h1>
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <i class="bi bi-exclamation-triangle me-2"></i>Confirmar Eliminação
            </div>
            <div class="card-body">
                <p>Tem a certeza que pretende eliminar a tag <strong>@Model.Tag?.Nome</strong>?</p>
                @if (Model.TotalServicos > 0)
                {
                    <p class="text-muted small">
                        <i class="bi bi-info-circle me-1"></i>
                        Esta tag está associada a @Model.TotalServicos serviço(s). A associação será removida.
                    </p>
                }
                <form method="post">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Confirmar
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
