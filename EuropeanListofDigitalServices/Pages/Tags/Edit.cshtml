@page "{id:int}"
@model EuropeanListofDigitalServices.Pages.Tags.EditModel
@{
    ViewData["Title"] = "Editar Tag";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <h1 class="mb-4"><i class="bi bi-pencil me-2 text-warning"></i>Editar Tag</h1>
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form method="post">
                    <input type="hidden" asp-for="Tag.Id"/>
                    <div class="mb-3">
                        <label asp-for="Tag.Nome" class="form-label fw-bold"></label>
                        <input asp-for="Tag.Nome" class="form-control"/>
                        <span asp-validation-for="Tag.Nome" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Guardar</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial"/> }
