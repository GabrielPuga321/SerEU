@page
@model EuropeanListofDigitalServices.Pages.IndexModel
@{
    ViewData["Title"] = "Início";
}

<!-- Hero Section -->
<div class="hero-section text-white text-center py-5 rounded-3 mb-4">
    <h1 class="display-5 fw-bold"><i class="bi bi-globe-europe-africa me-2"></i>Serviços Digitais Europeus</h1>
    <p class="lead mb-4">Descubra e partilhe plataformas digitais abertas, europeias e respeitadoras da privacidade.</p>
    <form method="get" asp-page="/Servicos/Index" class="d-flex justify-content-center gap-2 flex-wrap">
        <input type="text" name="pesquisa" class="form-control form-control-lg" style="max-width:450px"
               placeholder="Pesquisar serviços..."/>
        <button class="btn btn-warning btn-lg fw-bold" type="submit">
            <i class="bi bi-search me-1"></i>Pesquisar
        </button>
    </form>
</div>

<!-- Serviços em Destaque -->
<h2 class="mb-3"><i class="bi bi-star-fill text-warning me-2"></i>Serviços em Destaque</h2>
<div class="row g-3 mb-4">
    @foreach (var servico in Model.ServicosDestaque)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 card-servico">
                <div class="card-body">
                    <div class="d-flex align-items-start gap-3">
                        @if (!string.IsNullOrEmpty(servico.LogotipoUrl))
                        {
                            <img src="@servico.LogotipoUrl" alt="@servico.Nome" class="rounded" style="width:48px;height:48px;object-fit:contain" onerror="this.style.display='none'"/>
                        }
                        else
                        {
                            <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center" style="width:48px;height:48px;font-size:1.5rem">
                                <i class="bi @(servico.Categoria.Icone ?? "bi-app")"></i>
                            </div>
                        }
                        <div class="flex-grow-1 min-w-0">
                            <h5 class="card-title mb-1">@servico.Nome</h5>
                            <span class="badge bg-secondary small">@servico.Categoria.Nome</span>
                        </div>
                    </div>
                    <p class="card-text text-muted small mt-2">@(servico.Descricao.Length > 100 ? servico.Descricao[..100] + "…" : servico.Descricao)</p>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        @foreach (var tag in servico.Tags.Take(3))
                        {
                            <span class="badge bg-light text-dark border">@tag.Nome</span>
                        }
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                        <i class="bi bi-star-fill text-warning me-1"></i>
                        @(servico.MediaAvaliacoes > 0 ? servico.MediaAvaliacoes.ToString("F1") : "—")
                        (@servico.TotalAvaliacoes)
                    </small>
                    <a asp-page="/Servicos/Details" asp-route-id="@servico.Id" class="btn btn-primary btn-sm">
                        Ver Mais
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<!-- Categorias -->
<h2 class="mb-3"><i class="bi bi-grid-fill text-primary me-2"></i>Explorar por Categoria</h2>
<div class="row g-3 mb-4">
    @foreach (var cat in Model.Categorias)
    {
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-page="/Servicos/Index" asp-route-categoriaId="@cat.Id" class="text-decoration-none">
                <div class="card h-100 text-center border-0 shadow-sm card-categoria">
                    <div class="card-body py-3">
                        <i class="bi @(cat.Icone ?? "bi-app") fs-2 text-primary mb-2"></i>
                        <p class="card-text small fw-bold text-dark mb-0">@cat.Nome</p>
                        <p class="card-text text-muted" style="font-size:0.75rem">@cat.Servicos.Count(s => s.Aprovado) serviços</p>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

<!-- CTA para submeter -->
@if (!User.Identity?.IsAuthenticated ?? true)
{
    <div class="alert alert-info d-flex align-items-center gap-3">
        <i class="bi bi-person-plus fs-3"></i>
        <div>
            <strong>Conhece um serviço digital europeu ou aberto?</strong>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-sm ms-2">Registe-se e submeta!</a>
        </div>
    </div>
}
else
{
    <div class="alert alert-success d-flex align-items-center gap-3">
        <i class="bi bi-plus-circle fs-3"></i>
        <div>
            <strong>Conhece um serviço que ainda não está na lista?</strong>
            <a asp-page="/Servicos/Create" class="btn btn-success btn-sm ms-2">Submeter Serviço</a>
        </div>
    </div>
}
