@page
@model EuropeanListofDigitalServices.Pages.Categorias.CreateModel
@{
    ViewData["Title"] = "Nova Categoria";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <h1 class="mb-4"><i class="bi bi-plus-circle me-2 text-primary"></i>Nova Categoria</h1>
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Categoria.Nome" class="form-label fw-bold"></label>
                        <input asp-for="Categoria.Nome" class="form-control" placeholder="Ex: Comunicação"/>
                        <span asp-validation-for="Categoria.Nome" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Categoria.Descricao" class="form-label fw-bold"></label>
                        <textarea asp-for="Categoria.Descricao" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Categoria.Descricao" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Categoria.Icone" class="form-label fw-bold"></label>
                        <input asp-for="Categoria.Icone" class="form-control" placeholder="Ex: bi-chat-dots"/>
                        <div class="form-text">
                            Nome do ícone Bootstrap Icons (ver <a href="https://icons.getbootstrap.com" target="_blank">icons.getbootstrap.com</a>).
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Criar Categoria
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial"/> }
