@page
@model EuropeanListofDigitalServices.Pages.Admin.AprovacoesModel
@{
    ViewData["Title"] = "Aprovações Pendentes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-check2-circle me-2 text-warning"></i>Aprovações Pendentes</h1>
    <span class="badge bg-warning text-dark fs-6">@Model.ServicosPendentes pendente(s)</span>
</div>

@if (!Model.Servicos.Any())
{
    <div class="alert alert-success text-center py-5">
        <i class="bi bi-check2-circle fs-1 d-block mb-2"></i>
        <strong>Não há serviços pendentes de aprovação.</strong>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var servico in Model.Servicos)
        {
            <div class="col-md-6">
                <div class="card shadow-sm border-warning h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="fw-bold">@servico.Nome</span>
                        <span class="badge bg-secondary">@servico.Categoria.Nome</span>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small">@servico.Descricao</p>
                        <ul class="list-unstyled small">
                            <li><i class="bi bi-link me-1"></i><a href="@servico.Url" target="_blank">@servico.Url</a></li>
                            @if (!string.IsNullOrEmpty(servico.Pais))
                            {
                                <li><i class="bi bi-geo-alt me-1"></i>@servico.Pais</li>
                            }
                            @if (!string.IsNullOrEmpty(servico.Licenca))
                            {
                                <li><i class="bi bi-file-text me-1"></i>@servico.Licenca</li>
                            }
                            <li><i class="bi bi-calendar me-1"></i>@servico.DataSubmissao.ToString("dd/MM/yyyy HH:mm")</li>
                        </ul>
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            @foreach (var tag in servico.Tags)
                            {
                                <span class="badge bg-light text-dark border">@tag.Nome</span>
                            }
                        </div>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <form method="post" asp-page-handler="Aprovar" class="d-inline">
                            <input type="hidden" name="id" value="@servico.Id"/>
                            <button type="submit" class="btn btn-success btn-sm">
                                <i class="bi bi-check2 me-1"></i>Aprovar
                            </button>
                        </form>
                        <a asp-page="/Servicos/Details" asp-route-id="@servico.Id" class="btn btn-outline-primary btn-sm">
                            Ver Detalhes
                        </a>
                        <a asp-page="/Servicos/Delete" asp-route-id="@servico.Id" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-trash me-1"></i>Rejeitar
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
